<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFFFFF" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="18dp" android:paddingRight="12dp" android:paddingTop="10dp"
        android:paddingBottom="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Centra" android:textColor="#243B30" android:textSize="29sp"
                android:textStyle="bold" />
        </LinearLayout>
        <Button android:id="@+id/libraryButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Home" />
    </LinearLayout>
    <ScrollView android:id="@+id/libraryPanel" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <ImageView android:id="@+id/heroImage" android:layout_width="match_parent"
                android:layout_height="282dp" android:scaleType="centerCrop"
                android:contentDescription="Light green ceramic bowl" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:id="@+id/heroCreditText" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Photo credit and license" android:textColor="#526D60"
                    android:textColorLink="#397B60" android:textSize="12sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginLeft="20dp" android:layout_marginRight="20dp"
                android:background="#E4EAE5" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingTop="20dp" android:paddingBottom="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageButton android:id="@+id/myVesselsButton" android:layout_width="74dp"
                        android:layout_height="74dp" android:background="@drawable/bg_action_secondary"
                        android:src="@drawable/ic_folder" android:contentDescription="Jump to saved vessels" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingTop="8dp" android:text="My vessels" android:textColor="#53625C"
                        android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageButton android:id="@+id/pickButton" android:layout_width="82dp"
                        android:layout_height="82dp" android:background="@drawable/bg_action_primary"
                        android:src="@drawable/ic_gallery" android:contentDescription="Pick a pottery photo" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingTop="8dp" android:text="Pick photo" android:textColor="#397B60"
                        android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageButton android:id="@+id/liveButton" android:layout_width="74dp"
                        android:layout_height="74dp" android:background="@drawable/bg_action_secondary"
                        android:src="@drawable/ic_camera" android:contentDescription="Open live camera" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingTop="8dp" android:text="Live camera" android:textColor="#53625C"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingLeft="12dp" android:paddingRight="12dp"
                android:paddingBottom="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Saved vessels" android:textColor="#243B30"
                    android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/newFolderButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="New folder" />
            <LinearLayout android:id="@+id/libraryContent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingLeft="12dp" android:paddingRight="12dp"
                android:paddingBottom="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Pinterest references" android:textColor="#243B30"
                    android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/addPinterestButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Add pin or board link" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingBottom="6dp" android:textColor="#526D60" android:textSize="12sp"
                    android:text="Save links for inspiration. Use Pick photo to trace a vessel image." />
                <LinearLayout android:id="@+id/pinterestContent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:id="@+id/cameraPanel" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:background="#1C1714"
        android:visibility="gone">
        <androidx.camera.view.PreviewView android:id="@+id/preview"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:scaleType="fillCenter" />
        <com.example.potterywheeldetector.DetectionOverlay android:id="@+id/overlay"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
    <ScrollView android:id="@+id/galleryPanel" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp">
                <Button android:id="@+id/saveVesselButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:enabled="false" android:text="Save vessel" />
                <Button android:id="@+id/open3dButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:enabled="false" android:text="Open 3D" />
                <Button android:id="@+id/exportButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:enabled="false" android:text="Export OBJ" />
            </LinearLayout>
            <com.example.potterywheeldetector.GalleryOutlineView android:id="@+id/galleryImage"
                android:layout_width="match_parent" android:layout_height="300dp"
                android:background="#29211D" />
            <Switch android:id="@+id/mlOutlineSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingLeft="12dp"
                android:paddingRight="12dp" android:checked="true"
                android:text="Use ML outline (tap inside vessel)" />
            <SeekBar android:id="@+id/sensitivity" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingLeft="12dp"
                android:paddingRight="12dp" android:max="100" android:progress="50" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="12dp" android:textColor="#675A50"
                android:text="Tap inside the vessel to guide the outline. Use a straight-on photo of one upright pot." />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="12dp" android:text="2D profile" android:textColor="#2D241E"
                android:textSize="18sp" android:textStyle="bold" />
            <com.example.potterywheeldetector.ProfileView android:id="@+id/profileView"
                android:layout_width="match_parent" android:layout_height="300dp"
                android:background="#E9DDD0" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="12dp" android:paddingTop="12dp"
                android:text="Scale and clay estimate" android:textColor="#2D241E"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="12dp" android:paddingTop="8dp" android:text="Known height (cm)"
                android:textColor="#675A50" />
            <EditText android:id="@+id/heightInput" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Vessel height in cm"
                android:inputType="numberDecimal" android:singleLine="true"
                android:paddingLeft="12dp" android:paddingRight="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="12dp" android:paddingTop="8dp" android:text="Assumed wall and base thickness (mm)"
                android:textColor="#675A50" />
            <EditText android:id="@+id/wallInput" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Wall thickness in mm"
                android:inputType="numberDecimal" android:singleLine="true" android:text="5"
                android:paddingLeft="12dp" android:paddingRight="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="12dp" android:paddingTop="8dp" android:text="Extra clay for trimming (%)"
                android:textColor="#675A50" />
            <EditText android:id="@+id/allowanceInput" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Trimming allowance in %"
                android:inputType="numberDecimal" android:singleLine="true" android:text="25"
                android:paddingLeft="12dp" android:paddingRight="12dp" />
            <TextView android:id="@+id/measurementsText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="12dp"
                android:text="Enter a vessel height to see dimensions and clay estimate."
                android:textColor="#2D241E" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingBottom="18dp"
                android:textColor="#675A50"
                android:text="Approximate wet clay to centre on the wheel. Assumes a uniform wall and base, 1.8 g/cm³ clay density, and rotational symmetry. The photo cannot reveal the inside shape or shrinkage." />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/viewerPanel" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:visibility="gone" android:background="#1C1714">
        <Button android:id="@+id/backToProfileButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Back to profile" />
        <com.example.potterywheeldetector.Vessel3DView android:id="@+id/vessel3dView"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:padding="12dp" android:textColor="#FFFFFF"
            android:text="Drag to rotate the vessel" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="56dp" android:padding="14dp"
        android:text="Open a vessel or pick a photo." android:textColor="#2D241E"
        android:textSize="14sp" />
</LinearLayout>
