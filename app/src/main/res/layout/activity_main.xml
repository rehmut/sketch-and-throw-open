<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/housing" android:orientation="vertical">

    <!-- Header: brand on home, back + title elsewhere. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="4dp" android:paddingRight="4dp">
        <ImageButton android:id="@+id/backButton" style="@style/IconButton"
            android:src="@drawable/ic_back" android:contentDescription="Back"
            android:visibility="gone" />
        <LinearLayout android:id="@+id/brandGroup" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="12dp">
            <ImageView android:layout_width="22dp" android:layout_height="26dp"
                android:layout_gravity="center_vertical" android:src="@drawable/ic_logo"
                android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" android:layout_marginLeft="10dp"
                android:text="sketch &amp; throw" android:textColor="@color/graphite" android:textSize="21sp"
                android:fontFamily="sans-serif" android:letterSpacing="0.02" />
        </LinearLayout>
        <TextView android:id="@+id/titleText" style="@style/Title" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        <LinearLayout android:id="@+id/ledGroup" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingRight="4dp">
            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                android:src="@drawable/led" android:importantForAccessibility="no" />
            <TextView style="@style/Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginLeft="6dp"
                android:text="on device" />
        </LinearLayout>
        <Button android:id="@+id/headerAction" style="@style/Ghost"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:layout_marginRight="8dp" android:minHeight="40dp" android:visibility="gone" />
        <ImageButton android:id="@+id/settingsButton" style="@style/IconButton"
            android:src="@drawable/ic_settings" android:contentDescription="Settings" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/rule" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Home -->
        <LinearLayout android:id="@+id/homePanel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical"
            android:padding="@dimen/gutter">
            <ImageView android:id="@+id/heroImage" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter"
                android:background="@drawable/bg_hero" android:padding="18dp"
                android:src="@drawable/hero_illustration"
                android:contentDescription="Line drawing of a thrown bowl" />
            <TextView style="@style/Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:fontFamily="monospace" android:textSize="11sp"
                android:text="photograph · trace · measure · weigh the clay" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="14dp" android:background="@color/rule" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal"
                android:gravity="bottom">
                <Button android:id="@+id/myVesselsButton" style="@style/Key"
                    android:layout_width="0dp" android:layout_height="88dp"
                    android:layout_weight="1" android:drawableTop="@drawable/ic_folder"
                    android:text="my vessels" />
                <Button android:id="@+id/pickButton" style="@style/Key.Primary"
                    android:layout_width="0dp" android:layout_height="112dp"
                    android:layout_weight="1" android:layout_marginLeft="@dimen/gap"
                    android:layout_marginRight="@dimen/gap"
                    android:drawableTop="@drawable/ic_gallery" android:text="pick photo" />
                <Button android:id="@+id/liveButton" style="@style/Key"
                    android:layout_width="0dp" android:layout_height="88dp"
                    android:layout_weight="1" android:drawableTop="@drawable/ic_camera"
                    android:text="live camera" />
            </LinearLayout>
            <TextView style="@style/Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="categories" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/categoryRow" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView style="@style/Label" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="recent" />
                <TextView android:id="@+id/allVesselsLink" style="@style/Label"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:gravity="center_vertical" android:paddingLeft="12dp"
                    android:textColor="@color/graphite" android:text="all vessels ›"
                    android:background="@drawable/bg_icon_button" />
            </LinearLayout>
            <LinearLayout android:id="@+id/recentRow" android:layout_width="match_parent"
                android:layout_height="92dp" android:orientation="horizontal" />
            <TextView android:id="@+id/recentEmpty" style="@style/Label"
                android:layout_width="match_parent" android:layout_height="92dp"
                android:gravity="center" android:background="@drawable/bg_panel_dim"
                android:text="saved vessels appear here" android:visibility="gone" />
            <io.github.rehmut.sketchandthrow.GrilleView android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="0.28"
                android:layout_marginTop="14dp" android:minHeight="36dp"
                android:background="@drawable/bg_panel_dim" />
        </LinearLayout>

        <!-- Library -->
        <ScrollView android:id="@+id/libraryPanel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:id="@+id/libraryContent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingLeft="@dimen/gutter" android:paddingRight="@dimen/gutter"
                android:paddingBottom="@dimen/gutter" />
        </ScrollView>

        <!-- Live camera -->
        <FrameLayout android:id="@+id/cameraPanel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@color/graphite"
            android:visibility="gone">
            <androidx.camera.view.PreviewView android:id="@+id/preview"
                android:layout_width="match_parent" android:layout_height="match_parent"
                app:scaleType="fillCenter" />
            <io.github.rehmut.sketchandthrow.DetectionOverlay android:id="@+id/overlay"
                android:layout_width="match_parent" android:layout_height="match_parent" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:gravity="center_horizontal"
                android:orientation="vertical" android:paddingBottom="24dp">
                <TextView style="@style/Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/bg_chip"
                    android:fontFamily="monospace" android:paddingLeft="8dp" android:paddingRight="8dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:textColor="@color/graphite" android:textSize="11sp"
                    android:text="one pot, side-on, plain background" />
                <ImageButton android:id="@+id/shutterButton" android:layout_width="76dp"
                    android:layout_height="76dp" android:layout_marginTop="14dp"
                    android:background="@drawable/bg_shutter" android:src="@drawable/ic_camera"
                    android:contentDescription="Take picture and trace the vessel" />
            </LinearLayout>
        </FrameLayout>

        <!-- Vessel: four steps under one rocker switch -->
        <LinearLayout android:id="@+id/vesselPanel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/gutter" android:layout_marginRight="@dimen/gutter"
                android:layout_marginTop="12dp" android:background="@drawable/bg_rocker"
                android:orientation="horizontal" android:padding="3dp">
                <Button android:id="@+id/stepOutline" style="@style/RockerItem" android:text="01 outline" />
                <Button android:id="@+id/stepHandle" style="@style/RockerItem"
                    android:layout_marginLeft="3dp" android:text="02 handle" />
                <Button android:id="@+id/stepMeasure" style="@style/RockerItem"
                    android:layout_marginLeft="3dp" android:text="03 measure" />
                <Button android:id="@+id/step3d" style="@style/RockerItem"
                    android:layout_marginLeft="3dp" android:text="04 3d" />
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1">

                <!-- 01 outline -->
                <ScrollView android:id="@+id/outlinePanel" android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="@dimen/gutter">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="340dp"
                            android:background="@drawable/bg_display" android:padding="6dp">
                            <io.github.rehmut.sketchandthrow.GalleryOutlineView
                                android:id="@+id/galleryImage" android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Photo with the traced vessel outline. Tap inside the vessel to guide it." />
                            <TextView style="@style/Label" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_margin="8dp"
                                android:background="@drawable/bg_chip" android:fontFamily="monospace"
                                android:paddingLeft="6dp" android:paddingRight="6dp"
                                android:paddingTop="3dp" android:paddingBottom="3dp"
                                android:textColor="@color/graphite" android:textSize="11sp"
                                android:text="tap inside the vessel" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_large" android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/Body" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium" android:text="ML outline" />
                                <TextView style="@style/Label" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="off = colour outline" />
                            </LinearLayout>
                            <Switch android:id="@+id/mlOutlineSwitch" style="@style/BraunSwitch"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:checked="true" android:contentDescription="Use ML outline" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap" android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/Body" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium" android:text="find a handle" />
                                <TextView style="@style/Label" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="on for mugs and cups" />
                            </LinearLayout>
                            <Switch android:id="@+id/detectHandleSwitch" style="@style/BraunSwitch"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:contentDescription="Find a handle" />
                        </LinearLayout>
                        <io.github.rehmut.sketchandthrow.FaderControl android:id="@+id/sensitivity"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_large"
                            app:faderLabel="sensitivity" app:faderMin="0" app:faderMax="100"
                            app:faderStep="1" app:faderValue="50"
                            app:faderLowLabel="tight" app:faderHighLabel="loose" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gutter" android:background="@drawable/bg_panel_dim"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:paddingLeft="12dp" android:paddingRight="4dp"
                            android:minHeight="52dp">
                            <ImageView android:id="@+id/outlineLed" android:layout_width="12dp"
                                android:layout_height="12dp" android:src="@drawable/led"
                                android:importantForAccessibility="no" />
                            <TextView android:id="@+id/outlineStatus" style="@style/Label"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginLeft="8dp"
                                android:paddingTop="8dp" android:paddingBottom="8dp"
                                android:textColor="@color/graphite_soft" />
                            <Button android:id="@+id/outlineNext" style="@style/Ghost"
                                android:layout_width="wrap_content" android:layout_height="40dp"
                                android:layout_margin="4dp" android:minHeight="40dp"
                                android:background="@drawable/bg_icon_button"
                                android:fontFamily="monospace" android:text="next ›" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- 02 handle -->
                <ScrollView android:id="@+id/handlePanel" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="@dimen/gutter">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="280dp"
                            android:background="@drawable/bg_display" android:padding="6dp">
                            <io.github.rehmut.sketchandthrow.HandleView android:id="@+id/handleView"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@drawable/bg_panel" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_large" android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/Body" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium" android:text="find a handle" />
                                <TextView android:id="@+id/handleSideText" style="@style/Label"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            </LinearLayout>
                            <Switch android:id="@+id/handleSwitch" style="@style/BraunSwitch"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:contentDescription="Find a handle" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/noHandleCard" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_large"
                            android:background="@drawable/bg_panel" android:orientation="vertical"
                            android:padding="14dp" android:visibility="gone">
                            <TextView android:id="@+id/noHandleTitle" style="@style/Title"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:id="@+id/noHandleText" style="@style/Label"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.3" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/handleControls" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView style="@style/Label" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_large"
                                android:text="cross-section" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="6dp" android:orientation="horizontal">
                                <Button android:id="@+id/sectionRound" style="@style/Key"
                                    android:layout_width="0dp" android:layout_height="68dp"
                                    android:layout_weight="1" android:drawableTop="@drawable/ic_section_round"
                                    android:text="round" />
                                <Button android:id="@+id/sectionOval" style="@style/Key"
                                    android:layout_width="0dp" android:layout_height="68dp"
                                    android:layout_weight="1" android:layout_marginLeft="@dimen/gap"
                                    android:layout_marginRight="@dimen/gap"
                                    android:drawableTop="@drawable/ic_section_oval" android:text="oval" />
                                <Button android:id="@+id/sectionStrap" style="@style/Key"
                                    android:layout_width="0dp" android:layout_height="68dp"
                                    android:layout_weight="1" android:drawableTop="@drawable/ic_section_strap"
                                    android:text="pulled strap" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/gutter" android:orientation="horizontal">
                                <TextView style="@style/Body" android:layout_width="0dp"
                                    android:layout_height="wrap_content" android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium" android:text="thickness · from photo" />
                                <TextView android:id="@+id/handleThicknessText" style="@style/Readout"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:textSize="15sp" />
                            </LinearLayout>
                            <io.github.rehmut.sketchandthrow.FaderControl android:id="@+id/handleWidthFader"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/gap_large"
                                app:faderLabel="width front to back · assumed" app:faderUnit="mm"
                                app:faderMin="4" app:faderMax="60" app:faderStep="1" app:faderValue="20" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/gutter" android:background="@drawable/bg_display"
                                android:orientation="horizontal" android:padding="14dp">
                                <TextView style="@style/Readout" android:layout_width="0dp"
                                    android:layout_height="wrap_content" android:layout_weight="1"
                                    android:textColor="@color/on_graphite" android:textSize="13sp"
                                    android:text="handle clay" />
                                <TextView android:id="@+id/handleClayText" style="@style/Readout"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:textColor="@color/key" android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- 03 measure -->
                <ScrollView android:id="@+id/measurePanel" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:visibility="gone">
                    <LinearLayout android:id="@+id/measureContent" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="@dimen/gutter">
                        <LinearLayout android:id="@+id/measureTop" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal">
                            <io.github.rehmut.sketchandthrow.ProfileView android:id="@+id/profileView"
                                android:layout_width="150dp" android:layout_height="190dp"
                                android:background="@drawable/bg_panel"
                                android:contentDescription="Technical drawing with lettered dimensions. Tap to enlarge." />
                            <LinearLayout android:id="@+id/heightBlock" android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginLeft="12dp"
                                android:orientation="vertical">
                                <TextView style="@style/Label" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:labelFor="@+id/heightInput"
                                    android:text="known height" />
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp" android:background="@drawable/bg_display"
                                    android:orientation="horizontal" android:gravity="bottom|end"
                                    android:paddingLeft="12dp" android:paddingRight="12dp"
                                    android:paddingTop="6dp" android:paddingBottom="10dp">
                                    <EditText android:id="@+id/heightInput" android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" android:minWidth="96dp"
                                        android:background="@null" android:fontFamily="monospace"
                                        android:gravity="end" android:hint="—"
                                        android:importantForAutofill="no" android:inputType="numberDecimal"
                                        android:imeOptions="actionDone"
                                        android:singleLine="true" android:textColor="@color/key"
                                        android:textColorHint="@color/scale" android:textSize="28sp" />
                                    <TextView style="@style/Readout" android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" android:layout_marginLeft="6dp"
                                        android:textColor="@color/on_graphite" android:textSize="13sp"
                                        android:text="cm" />
                                </LinearLayout>
                                <TextView style="@style/Label" android:layout_width="match_parent"
                                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                                    android:lineSpacingMultiplier="1.2"
                                    android:text="at the stage you want to throw" />
                                <TextView android:id="@+id/ratioText" style="@style/Readout"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/specList" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:orientation="vertical" />
                        <LinearLayout android:id="@+id/claySettingsStrip" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_large"
                            android:background="@drawable/bg_clickable_row" android:clickable="true"
                            android:focusable="true" android:gravity="center_vertical"
                            android:minHeight="56dp" android:orientation="horizontal"
                            android:paddingLeft="12dp" android:paddingRight="8dp"
                            android:paddingTop="8dp" android:paddingBottom="10dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/Label" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="clay settings" />
                                <TextView android:id="@+id/claySettingsText" style="@style/Readout"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                                android:src="@drawable/ic_next" android:scaleType="center"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_large" android:background="@drawable/bg_display"
                            android:orientation="vertical" android:padding="@dimen/gutter">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:letterSpacing="0.05"
                                    android:textColor="@color/on_graphite" android:textSize="12sp"
                                    android:text="clay to centre" />
                                <ImageView android:layout_width="8dp" android:layout_height="8dp"
                                    android:src="@drawable/led_signal" android:importantForAccessibility="no" />
                            </LinearLayout>
                            <TextView android:id="@+id/clayTotalText" style="@style/Readout"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="6dp" android:gravity="end"
                                android:textColor="@color/key" android:textSize="42sp" android:text="—" />
                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:layout_marginTop="10dp" android:background="@color/graphite_soft" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="10dp" android:orientation="horizontal">
                                <TextView android:id="@+id/clayBodyText" style="@style/Readout"
                                    android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:textColor="@color/on_graphite"
                                    android:textSize="12sp" />
                                <TextView android:id="@+id/clayHandleText" style="@style/Readout"
                                    android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:textColor="@color/on_graphite"
                                    android:textSize="12sp" />
                                <TextView android:id="@+id/clayTrimText" style="@style/Readout"
                                    android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:textColor="@color/on_graphite"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView style="@style/Label" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:lineSpacingMultiplier="1.3"
                            android:text="wet clay to centre on the wheel. assumes a uniform wall and base, 1.8 g/cm³ and a symmetric body. the photo cannot show the inside or shrinkage." />
                    </LinearLayout>
                </ScrollView>

                <!-- 04 3d -->
                <LinearLayout android:id="@+id/viewerPanel" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:orientation="vertical"
                    android:padding="@dimen/gutter" android:visibility="gone">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:background="@drawable/bg_display"
                        android:padding="4dp">
                        <io.github.rehmut.sketchandthrow.Vessel3DView android:id="@+id/vessel3dView"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:contentDescription="Rotatable 3D model of the vessel. Drag to turn it." />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_margin="10dp" android:fontFamily="monospace"
                            android:textColor="@color/on_graphite" android:textSize="11sp"
                            android:text="drag to rotate" />
                        <TextView android:id="@+id/viewerUnits" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_gravity="end"
                            android:layout_margin="10dp" android:fontFamily="monospace"
                            android:textColor="@color/on_graphite" android:textSize="11sp" />
                    </FrameLayout>
                    <Button android:id="@+id/exportButton" style="@style/Key"
                        android:layout_width="match_parent" android:layout_height="64dp"
                        android:layout_marginTop="12dp" android:drawableLeft="@drawable/ic_export"
                        android:paddingLeft="24dp" android:paddingRight="24dp"
                        android:enabled="false" android:text="export OBJ" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Settings -->
        <ScrollView android:id="@+id/settingsPanel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/gutter">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView style="@style/Label" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="01 clay defaults" />
                    <TextView style="@style/Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="for new vessels" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:background="@drawable/bg_panel"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:padding="12dp">
                    <ImageView android:layout_width="120dp" android:layout_height="104dp"
                        android:src="@drawable/section_diagram" android:scaleType="fitCenter"
                        android:contentDescription="Half section of a pot marking wall and base thickness" />
                    <TextView style="@style/Label" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginLeft="14dp" android:lineSpacingMultiplier="1.3"
                        android:text="a photo shows only the outside. these values fill in what it can't see." />
                </LinearLayout>
                <io.github.rehmut.sketchandthrow.FaderControl android:id="@+id/settingsWall"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" app:faderLabel="wall" app:faderUnit="mm"
                    app:faderMin="2" app:faderMax="20" app:faderStep="0.5" app:faderValue="5"
                    app:faderLowLabel="2 · thin" app:faderHighLabel="heavy · 20" />
                <io.github.rehmut.sketchandthrow.FaderControl android:id="@+id/settingsBase"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" app:faderLabel="base" app:faderUnit="mm"
                    app:faderMin="2" app:faderMax="30" app:faderStep="0.5" app:faderValue="5"
                    app:faderLowLabel="2" app:faderHighLabel="left to trim · 30" />
                <io.github.rehmut.sketchandthrow.FaderControl android:id="@+id/settingsTrim"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" app:faderLabel="trimming allowance"
                    app:faderUnit="%" app:faderMin="0" app:faderMax="100" app:faderStep="1"
                    app:faderValue="25" app:faderLowLabel="0" app:faderHighLabel="extra clay · 100" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="18dp" android:background="@color/rule" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Body" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                            android:text="apply to open vessel" />
                        <TextView android:id="@+id/applyToOpenHint" style="@style/Label"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="otherwise only new vessels change" />
                    </LinearLayout>
                    <Switch android:id="@+id/applyToOpenSwitch" style="@style/BraunSwitch"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:contentDescription="Apply to open vessel" />
                </LinearLayout>
                <TextView style="@style/Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="28dp"
                    android:fontFamily="monospace" android:text="density 1.8 g/cm³ · fixed" />
                <Button android:id="@+id/resetDefaultsButton" style="@style/Ghost"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp" android:text="reset to defaults" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="28dp" android:background="@color/rule" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <TextView style="@style/Label" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="02 about" />
                    <TextView android:id="@+id/versionText" style="@style/Label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" />
                </LinearLayout>
                <TextView style="@style/Label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="photos are traced on this phone and never uploaded. google ml kit sends anonymous diagnostics about how its detector runs." />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal">
                    <Button android:id="@+id/licencesButton" style="@style/Ghost"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:text="licences" />
                    <Button android:id="@+id/privacyButton" style="@style/Ghost"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:layout_marginLeft="@dimen/gap"
                        android:text="privacy policy" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@color/housing_dim"
        android:fontFamily="monospace" android:minHeight="40dp" android:paddingLeft="@dimen/gutter"
        android:paddingRight="@dimen/gutter" android:paddingTop="10dp" android:paddingBottom="10dp"
        android:textColor="@color/graphite_soft" android:textSize="12sp"
        android:accessibilityLiveRegion="polite" android:visibility="gone" />
</LinearLayout>
